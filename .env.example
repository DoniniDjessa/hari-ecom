# hari-ecom (haristorecosmetics.com) : variables d'environnement. Copier en .env (local) ou les saisir chez
# l'hébergeur (production). Ne jamais publier les vraies valeurs.

# Adresse du site en production (liens canoniques, sitemap, données Google)
NEXT_PUBLIC_SITE_URL=https://haristorecosmetics.com

# Base de données de la web app (Supabase) : lecture du catalogue, commandes, fidélité
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Photos (Cloudflare R2, même bucket que la web app)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Numéro WhatsApp de la boutique (format international, chiffres seulement)
NEXT_PUBLIC_WHATSAPP_NUMBER=2250779802303

# Rafraîchissement immédiat par la web app : même valeur que ECOM_REVALIDATE_SECRET dans haritest
REVALIDATE_SECRET=

# Mesure d'audience (facultatif) : Google Analytics 4 « G-XXXXXXX », pixel Meta
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Google Search Console : code de la vérification « balise HTML » (facultatif)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# true : montre aussi les produits non cochés « Afficher sur le site » (préparation uniquement)
SITE_PREVIEW_ALL=false
